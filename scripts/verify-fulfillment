      pngInspectionReport = runPngInspectionTests();
      checks = pngInspectionReport.results ?? [];
      if (!validPngInspectionRunnerReport(pngInspectionReport)) {
        failureReasons.push("png_inspection_runner_report_invalid");
      } else if (pngInspectionReport.status === "passed" &&
        pngInspectionReport.passed === PNG_INSPECTION_SUITE_CASE_COUNT && pngInspectionReport.failed === 0 &&
        checks.length === PNG_INSPECTION_SUITE_CASE_COUNT && checks.every((check) => check.status === "passed")) {
        status = "passed";
      } else {
        failureReasons.push("one_or_more_private_png_inspection_checks_failed");
      }
    }
  } catch {
    failureReasons.push("png_inspection_suite_prerequisite_failed");
  }
} else if (failureReasons.length === 0 && args.suite === "order-authorization" && args.mode === "simulated") {
  if (!orderAuthorizationApiAvailable) failureReasons.push("order_authorization_runtime_build_prerequisite_missing");
  try {
    if (failureReasons.length === 0) {
      orderAuthorizationReport = runOrderAuthorizationTests();
      checks = orderAuthorizationReport.results ?? [];
      if (!validOrderAuthorizationRunnerReport(orderAuthorizationReport)) {
        failureReasons.push("order_authorization_runner_report_invalid");
      } else if (orderAuthorizationReport.status === "passed" &&
        orderAuthorizationReport.passed === ORDER_AUTHORIZATION_SUITE_CASE_COUNT && orderAuthorizationReport.failed === 0 &&
        checks.length === ORDER_AUTHORIZATION_SUITE_CASE_COUNT && checks.every((check) => check.status === "passed")) {
        status = "passed";
      } else {
        failureReasons.push("one_or_more_private_order_authorization_checks_failed");
      }
    }
  } catch {
    failureReasons.push("order_authorization_suite_prerequisite_failed");
  }
} else if (failureReasons.length === 0 && args.suite === "package" && args.mode === "simulated") {
  if (!packageApiAvailable) failureReasons.push("package_runtime_build_prerequisite_missing");
  try {
    if (failureReasons.length === 0) {
      packageReport = runPackageTests();
      checks = packageReport.results ?? [];
      if (!validPackageRunnerReport(packageReport)) {
        failureReasons.push("package_runner_report_invalid");
      } else if (packageReport.status === "passed" && packageReport.passed === PACKAGE_SUITE_CASE_COUNT && packageReport.failed === 0 &&
        checks.length === PACKAGE_SUITE_CASE_COUNT && checks.every((check) => check.status === "passed")) {
        packageRevision = sourceRevision(repositoryRoot);
        packageBundleReport = await buildPackageBundleReport({ repositoryRoot, revision: packageRevision.sha });
        if (packageBundleReport.verdict === "integrity_passed_blocked") status = "passed";
        else failureReasons.push("package_baseline_bundle_report_not_integrity_passed");
      } else {
        failureReasons.push("one_or_more_package_checks_failed");
      }
    }
  } catch {
    failureReasons.push("package_suite_prerequisite_failed");
  }
} else if (failureReasons.length === 0 && args.suite === "metering" && args.mode === "simulated") {
  if (!catalogAvailable) failureReasons.push("metering_build_prerequisite_missing");
  try {
    if (failureReasons.length === 0) {
      const { runMeteringTests } = await import("./run-metering-tests.mjs");
      const report = runMeteringTests();
      meteringReport = report;
      checks = report.results ?? [];
      if (report.status === "passed" && checks.length > 0 && checks.every((check) => check.status === "passed")) {
        status = "passed";
      } else {
        failureReasons.push("one_or_more_private_metering_fixture_checks_failed");
      }
    }
  } catch {
    failureReasons.push("metering_suite_prerequisite_failed");
  }
} else if (failureReasons.length === 0 && args.suite === "sandbox") {
  failureReasons.push("sandbox_adapter_and_accepted_contract_pins_unavailable");
} else if (failureReasons.length === 0 && args.suite === "release") {
  failureReasons.push("release_evidence_and_cross_repository_conformance_unavailable");
}

