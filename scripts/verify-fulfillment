if (args.suite === "package" && status === "passed" && !validPackageAssessment(result.packageAssessment)) {
  status = "failed";
  result.status = "failed";
  failureReasons.push("package_assessment_invalid");
}

if (args["evidence-dir"] !== undefined) {
  const evidenceDir = args.suite === "png-inspection" || args.suite === "order-authorization" || args.suite === "package"
    ? path.resolve(repositoryRoot, args["evidence-dir"])
    : path.resolve(args["evidence-dir"]);
  const evidenceFile = path.join(evidenceDir, "result.json");
  result.evidenceFile = evidenceFile;
  result.completedAt = new Date().toISOString();
  try {
    if (args.suite === "png-inspection" || args.suite === "order-authorization" || args.suite === "package") {
      const expectedEvidenceDir = path.resolve(repositoryRoot, args.suite === "png-inspection" ? "evidence/FC-08-10-PNG" : args.suite === "package" ? PACKAGE_EVIDENCE_DIR : "evidence/FC-ORDER-AUTH");
      if (evidenceDir !== expectedEvidenceDir) throw new Error("unsafe_evidence_directory");
      for (const candidate of [path.resolve(repositoryRoot, "evidence"), evidenceDir]) {
        try {
          const details = await lstat(candidate);
          if (!details.isDirectory() || details.isSymbolicLink()) throw new Error("unsafe_evidence_directory");
        } catch (error) {
          if (error?.code !== "ENOENT") throw error;
        }
      }
      try {
        const details = await lstat(evidenceFile);
        if (!details.isFile() || details.isSymbolicLink()) throw new Error("unsafe_evidence_file");
      } catch (error) {
        if (error?.code !== "ENOENT") throw error;
      }
    }
    await mkdir(evidenceDir, { recursive: true });
    if (result.pngInspectionAssessment !== undefined) result.pngInspectionAssessment.evidenceWriteStatus = "written";
    if (result.orderAuthorizationAssessment !== undefined) result.orderAuthorizationAssessment.evidenceWriteStatus = "written";
    if (result.packageAssessment !== undefined) result.packageAssessment.evidenceWriteStatus = "written";
    await writeFile(evidenceFile, `${JSON.stringify(result, null, 2)}\n`, { encoding: "utf8", flag: "w" });
  } catch {
    status = "failed";
    result.status = status;
    result.scope = "argument_or_prerequisite_check";
    failureReasons.push("evidence_write_failed");
    result.failureReasons = failureReasons;
    result.blockers = [
      ...blockers,
      ...(args.suite === "security" ? securityBlockers : []),
      ...(args.suite === "catalog" ? catalogBlockers : []),
      ...(args.suite === "mock" ? mockBlockers : []),
      ...(args.suite === "quote" ? quoteBlockers : []),
      ...(args.suite === "comparison" ? comparisonBlockers : []),
      ...(args.suite === "attempt-store" ? attemptStoreBlockers : []),
      ...(args.suite === "status" ? statusBlockers : []),
      ...(args.suite === "prodigi-product-details" ? prodigiProductDetailsBlockers : []),
      ...(args.suite === "png-inspection" ? pngInspectionBlockers : []),
      ...(args.suite === "order-authorization" ? orderAuthorizationBlockers : []),
      ...(args.suite === "package" ? PACKAGE_BLOCKERS : []),
      ...failureReasons
    ];
    if (result.catalogAssessment !== undefined) result.catalogAssessment.localFixtureResult = "failed";
    if (result.quoteAssessment !== undefined) result.quoteAssessment.localFixtureResult = "failed";
    if (result.comparisonAssessment !== undefined) {
      result.comparisonAssessment.localFixtureResult = "failed";
      result.comparisonAssessment.evidenceWriteStatus = "failed";
    }
    if (result.attemptStoreAssessment !== undefined) result.attemptStoreAssessment.localFixtureResult = "failed";
    if (result.prodigiProductDetailsAssessment !== undefined) {
      result.prodigiProductDetailsAssessment.localFixtureResult = "failed";
      result.prodigiProductDetailsAssessment.evidenceWriteStatus = "failed";
    }
    if (result.pngInspectionAssessment !== undefined) {
      result.pngInspectionAssessment.localFixtureResult = "failed";
      result.pngInspectionAssessment.evidenceWriteStatus = "failed";
    }
    if (result.orderAuthorizationAssessment !== undefined) {
      result.orderAuthorizationAssessment.localFixtureResult = "failed";
      result.orderAuthorizationAssessment.evidenceWriteStatus = "failed";
    }
    if (result.packageAssessment !== undefined) {
      result.packageAssessment.localFixtureResult = "failed";
      result.packageAssessment.evidenceWriteStatus = "failed";
    }
  }
}
process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
if (status !== "passed") process.exitCode = 1;
